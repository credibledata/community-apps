{
  "name": "credible-elections-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "malloy-publisher --server_root . --port 4000 --watch-env elections",
    "data": "node packages/midterms2026/pipeline/build-data.mjs",
    "data:real": "node packages/midterms2026/pipeline/data/fetch.mjs && node packages/midterms2026/pipeline/data/curate.mjs && node packages/midterms2026/pipeline/data/fetch-kalshi.mjs && node packages/midterms2026/pipeline/build-data.mjs",
    "data:validate": "node packages/midterms2026/pipeline/validate-data.mjs",
    "data:stub": "node packages/midterms2026/pipeline/generate-stub-data.mjs",
    "results": "node packages/midterms2026/pipeline/results.mjs",
    "geo": "node packages/midterms2026/pipeline/build-geo.mjs",
    "test": "node --test packages/midterms2026/tests/*.test.mjs"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@malloy-publisher/server": "0.9.1",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  }
}
